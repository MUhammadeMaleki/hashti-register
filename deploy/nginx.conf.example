# Replace CHANGE_ME.example.com and certificate paths, then test with nginx -t.
# Place the limit_req_zone declarations in the http context.
limit_req_zone $binary_remote_addr zone=hashti_auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=hashti_public:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=hashti_upload:10m rate=10r/m;

server {
    listen 80;
    server_name CHANGE_ME.example.com;
    return 301 https://CHANGE_ME.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name CHANGE_ME.example.com;
    ssl_certificate /etc/letsencrypt/live/CHANGE_ME.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/CHANGE_ME.example.com/privkey.pem;
    client_max_body_size 6m;
    server_tokens off;
    limit_req_status 429;

    # These regex locations must precede the general /api/ location.
    location ~ ^/api/auth/(admin/login|guest/login|guest/register|refresh)$ {
        limit_req zone=hashti_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
    }
    location ~ ^/api/public/events/[0-9]+/register$ {
        limit_req zone=hashti_public burst=15 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
    }
    location ~ ^/api/me/(events/[0-9]+/)?payments$ {
        limit_req zone=hashti_upload burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
    }
}
