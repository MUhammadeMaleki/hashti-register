[Unit]
Description=Hashti Next.js
After=network.target hashti-api.service

[Service]
Type=simple
User=hashti
Group=hashti
WorkingDirectory=/srv/hashti/current/frontend
EnvironmentFile=/etc/hashti/hashti.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/hashti/current/frontend/.next/cache

[Install]
WantedBy=multi-user.target
