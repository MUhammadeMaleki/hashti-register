# Install as /etc/hashti/hashti.env, owned by root:hashti with mode 0640.
# Replace every CHANGE_ME value; do not commit the populated file.
HASHTI_ENVIRONMENT=production
HASHTI_DATABASE_URL=postgresql+psycopg://hashti_app:CHANGE_ME@127.0.0.1:5432/hashti
HASHTI_AUTH_SECRET=CHANGE_ME_64_RANDOM_HEX_CHARACTERS
HASHTI_PUBLIC_ORIGIN=https://CHANGE_ME.example.com
HASHTI_UPLOADS_DIR=/var/lib/hashti/uploads
BACKEND_ORIGIN=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
